{
  "name": "zenexpander",
  "version": "0.2.0",
  "private": true,
  "description": "Privacy-first, zero-install text expansion for Chrome.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:release": "node scripts/clean-release.mjs",
    "build:bookmarklet": "node scripts/build-bookmarklet.mjs",
    "build": "npm run clean:release && npm run build:bookmarklet && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/config.test.mjs tests/bookmarklet.test.mjs tests/bridge-worker.test.mjs tests/dynamics-fixture.test.mjs",
    "test:browser": "playwright test",
    "test:release": "node --test tests/release.test.mjs",
    "check": "npm audit --audit-level=high && npm test && npm run build && npm run test:release && npm run test:browser"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "terser": "^5.49.1",
    "vite": "^8.2.0"
  }
}
